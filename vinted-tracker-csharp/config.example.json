{
  // Skopiuj do config.json i dostosuj (komentarze i przecinki końcowe są dozwolone).
  // Lista śledzonych gier mieszka osobno, w pliku wskazanym przez watchlistPath
  // (domyślnie games.json) i jest edytowalna z poziomu dashboardu.
  "defaults": {
    "baseUrl": "https://www.vinted.pl",
    "pollIntervalSeconds": 300,
    "statePath": "data/tracker.sqlite3",
    "watchlistPath": "games.json",
    "listenUrl": "http://localhost:5177",

    // ID katalogu "Gry" na danej domenie Vinted. Puste = tracker sam spróbuje
    // znaleźć je w drzewie kategorii przy pierwszym cyklu; jeśli mu się nie
    // uda, podejrzyj ID w URL katalogu w przeglądarce i wpisz tutaj.
    "catalogIds": [],

    // Pierwszy przebieg (pusta baza): ile stron po 96 ofert zassać na start.
    "backfillPages": 20,
    // Zwykły cykl: bezpiecznik stron po dłuższym postoju trackera.
    "maxPagesPerCycle": 5,
    // Push (Telegram/Discord) tylko gdy mediana - cena >= tyle (waluta rynku).
    "minMargin": 50,
    // Od ilu ofert grupa nierozpoznanych tytułów staje się grą "auto".
    "autoPromoteMinSample": 8,
    // Weryfikacja ofert po zdjęciach (Claude API) — włącza się, gdy ustawisz
    // zmienną ANTHROPIC_API_KEY. "claude-haiku-4-5" tnie koszt ~5x.
    "visionModel": "claude-opus-5"
  }
}
