{
  // Skopiuj do config.json i dostosuj (komentarze i przecinki końcowe są dozwolone).
  // Lista śledzonych gier mieszka osobno, w pliku wskazanym przez watchlistPath
  // (domyślnie games.json) i jest edytowalna z poziomu dashboardu.
  "defaults": {
    "baseUrl": "https://www.vinted.pl",
    "pollIntervalSeconds": 300,
    "statePath": "data/tracker.sqlite3",
    "watchlistPath": "games.json",
    "listenUrl": "http://localhost:5177",

    // Tryb wishlisty: śledzimy WYŁĄCZNIE gry z games.json (plus polowania na
    // konsole), każdą własnym zapytaniem w kolejce. false = dodatkowo firehose
    // po całym katalogu gier: większe pokrycie, ale w okazjach ląduje sporo
    // szumu spoza wishlisty.
    "watchlistOnly": true,
    // Ile gier z kolejki odpytać w jednym cyklu. Pełny obieg trwa
    // (liczba gier / to) × pollIntervalSeconds — przy 166 grach, 6 na cykl
    // i cyklu 300 s każda gra wraca co ~2,3 h.
    "watchQueuePerCycle": 6,

    // Poniższe działa tylko przy watchlistOnly = false.
    // ID katalogu "Gry" na danej domenie Vinted. Puste = tracker sam spróbuje
    // znaleźć je w drzewie kategorii przy pierwszym cyklu; jeśli mu się nie
    // uda, podejrzyj ID w URL katalogu w przeglądarce i wpisz tutaj.
    "catalogIds": [],

    // Pierwszy przebieg (pusta baza): ile stron po 96 ofert zassać na start.
    "backfillPages": 20,
    // Zwykły cykl: bezpiecznik stron po dłuższym postoju trackera.
    "maxPagesPerCycle": 5,
    // Push (Telegram/Discord) tylko gdy mediana - cena >= tyle (waluta rynku).
    "minMargin": 50,
    // Od ilu ofert grupa nierozpoznanych tytułów staje się grą "auto".
    "autoPromoteMinSample": 8,
    // Weryfikacja ofert po zdjęciach (Claude API) — włącza się, gdy ustawisz
    // zmienną ANTHROPIC_API_KEY. "claude-haiku-4-5" tnie koszt ~5x.
    "visionModel": "claude-opus-5",
    // AI odrzuca też gry bez pudełka widoczne na zdjęciu (sam kartridż/płyta).
    "visionRequireComplete": true,
    // Platformy wycinane całkowicie (nie wchodzą do median ani okazji).
    // Domyślnie wszystko poza Switchem; polowania na konsole działają mimo to.
    "excludedPlatforms": ["xbox-one", "xbox-series", "xbox360", "ps1", "ps2", "ps3",
      "ps4", "ps5", "psp", "psvita", "wii", "wiiu", "ds", "3ds", "gb", "gba",
      "n64", "gamecube", "snes", "ntsc", "pc"],
    // Polowanie na tanie KONSOLE: oferta ze słowem "konsola/console" i tą
    // platformą w cenie <= progu to mocna okazja z pushem. Części, wraki
    // ("uszkodzona", "obudowa") i ceny poniżej 30% progu są odsiewane.
    "platformHunts": { "3ds": 100, "psvita": 150, "ps3": 120, "ps4": 350, "xbox360": 100 }
  }
}
